/* pages/queueme/queueme.wxss */


.base{
    position: relative;
    border: 2px solid rgba(187, 223, 241, 0.7);
    border-radius: 20px;
}

.shadow {
    box-shadow: 0px 4px 4px rgba(0, 0, 0, 0.25);
}

.point {
    display: flex;
    align-items: center;
    justify-content: center;
    border-radius: 50%;
    position: absolute;
}

.point.selected {
    border: 4px solid white; /* 白色边框 */
  }

.line {
position: absolute;
background-color: rgba(211, 211, 211, 0.1);
}

.horizontal {
width: 100%;
height: 1px;
}

.vertical {
width: 1px;
height: 100%;
}

.player {
    width: 90vw;
    align-items: center;
    justify-content: center;
    margin: 24px 0;
}

.slider{
    margin: 0;
}

.time {
    width: 90vw;
    display: flex;
    justify-content: space-between;
}

.playBtn {
    width: 90vw;
    height: 56px;
    border-radius: 60px 10px 40px 10px;
    display: flex;
    justify-content: center;
    align-items: center;
}

.btn {
    display: flex;
    width: 90vw;
    gap: 6vw;
    align-items: center;
    justify-content: center;
    margin: 12px 0;
}

.count-ball{
    width: 36px;
    height: 36px;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
}

.queue-list {
    display: flex;
    white-space: nowrap;
    width: 98vw;
    height: 50px;
    margin: 32px 2px 0px;
}

.queue{
    display: flex;
    width: 100px;
    height: 42px;
    align-items: center;
    justify-content: center;
    border: 2px solid #fbc5ff;
    background-color: transparent;
    border-radius: 20px;
    margin: 0px 4px;
    padding: 0px 12px;
}

.queue-add{
    display: flex;
    width: 100px;
    height: 42px;
    align-items: center;
    justify-content: center;
    border: 2px solid rgba(187, 223, 241, 0.7);
    background-color: transparent;
    border-radius: 20px;
    margin: 0px 4px;
    padding: 0px 12px;
}

.distance {
    color: white;
    font-size: 11px;
    font-family: "Prompt";
    font-weight: 100;
    opacity: 0.7;
    position: absolute;
}

.active {

}

.active:active{
    box-shadow: 4px 8px 8px rgba(187, 223, 241, 0.2);
    transform: translateY(1vw);
}

.subBtn {
    width: 42vw;
    height: 50px;
    display: flex;
    justify-content: center;
    align-items: center;
}

.miniBtn{
    width: 48px;
    height: 48px;
    border-radius: 50%;
    display: flex;
    justify-content: center;
    align-items: center;
    margin: -12px 16px 16px 16px;
}

.withborder {
    border: 2px solid rgba(187, 223, 241, 0.7);
}




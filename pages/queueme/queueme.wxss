/* pages/queueme/queueme.wxss */


.base{
    position: relative;
    border: 2px solid rgba(187, 223, 241, 0.7);
    border-radius: 20px;
}

.shadow {
    box-shadow: 0px 4px 4px rgba(0, 0, 0, 0.25);
}

.point {
    display: flex;
    align-items: center;
    justify-content: center;
    border-radius: 50%;
    position: absolute;
}

.point.selected {
    border: 4px solid white; /* 白色边框 */
  }

.line {
position: absolute;
background-color: rgba(211, 211, 211, 0.1);
}

.horizontal {
width: 100%;
height: 1px;
}

.vertical {
width: 1px;
height: 100%;
}

.player {
    width: 90vw;
    height: 200px;
    align-items: center;
    justify-content: center;
    margin: 24px;
}

.slider{
    margin: 0;
}

.time {
    width: 90vw;
    display: flex;
    justify-content: space-between;
}

.playBtn {
    width: 72px;
    height: 72px;
    border-radius: 50%;
    font-size:25px;
    display: flex;
    justify-content: center;
    align-items: center;
    border: none;
    outline: none;
    cursor: pointer;
}

.round{
    display: flex;
    width: 24px;
    height: 24px;
    background-color: #2b2b2b;
    align-items: center;
    justify-content: center;
    border-radius: 50%;
    color: #fbc5ff;
    margin-bottom: 1px;
    margin-right: 3px;
}
  
.btn {
    display: flex;
    width: 90vw;
    gap: 10px;
    align-items: center;
    justify-content: center;
    margin-top: 12px;
}

.count-ball{
    width: 36px;
    height: 36px;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
}

.queue-list {
    display: flex;
    height: 56px;
    margin: 48px 2px 0px;
} 

.queue-list {
    display: flex;
    white-space: nowrap;
    width: 98vw;
    height: 6vh;
}

.queue{
    display: flex;
    width: 100px;
    align-items: center;
    justify-content: center;
    border: 2px solid #fbc5ff;
    background-color: transparent;
    border-radius: 20px;
    margin: 0px 4px;
    padding: 0px 12px;
}

.queue-add{
    display: flex;
    width: 100px;
    align-items: center;
    justify-content: center;
    border: 2px solid rgba(187, 223, 241, 0.7);
    background-color: transparent;
    border-radius: 20px;
    margin: 0px 4px;
    padding: 0px 12px;
}




/* pages/queueme/queueme.wxss */
.border{
    position: relative;
    width: 357px; /* 10 列，每列30px + 9 个10px 的间隔 */
    height: 231px; /* 8 行，每行30px + 7 个10px 的间隔 */
}

.base{
    position: absolute;
    width: 378px;
    height: 252px;
    top: -12px;
    left: -12px;
    z-index: -1;
}

.grid {
    position: relative;
    width: 357px; 
    height: 231px; 
    display: grid;
    grid-template-columns: repeat(17, 0px);
    grid-template-rows: repeat(11, 0px);
    grid-gap: 21px;
}

.point {
    display: flex;
    width: 18px;
    height: 18px;
    align-items: center;
    justify-content: center;
    border-radius: 50%;
}

.line {
position: absolute;
background-color: rgba(211, 211, 211, 0.1);
}

.horizontal {
width: 100%;
height: 1px;
}

.vertical {
width: 1px;
height: 100%;
}

.player {
    width: 90vw;
    height: 200px;
    align-items: center;
    justify-content: center;
    margin: 24px;
}

.slider{
    margin: 0;
}

.time {
    width: 90vw;
    display: flex;
    justify-content: space-between;
}

.playBtn {
    display: flex;
    width: 100px;
    height: 32px;
    border-radius: 20px;
    align-items: center;
    justify-content: center;
    text-align: center;
}

.round{
    display: flex;
    width: 20px;
    height: 20px;
    background-color: #2b2b2b;
    align-items: center;
    justify-content: center;
    border-radius: 50%;
    color: #fbc5ff;
    margin-bottom: 1px;
    margin-right: 3px;
}
  
.btn {
    display: flex;
    align-items: center;
    justify-content: center;
    margin-top: 12px;
}

.count-ball{
    width: 36px;
    height: 36px;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
}

  
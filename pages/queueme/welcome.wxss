/* pages/queueme/welcome.wxss */
.container{
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    height: 100vh;
}

.counter {
    display: flex;
    width: 200px;
    height: 56px;
    align-items: center;
    justify-content: center;
    border: 2px solid #fbc5ff;
    border-radius: 20px;
    margin: 12px 0px;
  }
  
.counter-btn {
    width: 40px;
    height: 40px;
    margin: 6px 12px;
}

.upload {
    display: flex;
    width: 200px;
    height: 56px;
    align-items: center;
    justify-content: center;
    border: 2px solid #fbc5ff;
    background-color: transparent;
    border-radius: 20px;
    margin: 12px 12px 24px;
}

.ready {
    display: flex;
    width: 200px;
    height: 56px;
    align-items: center;
    justify-content: center;
    border-radius: 20px;
    margin: 24px 0px;
}
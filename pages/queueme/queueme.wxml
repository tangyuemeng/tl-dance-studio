<!--pages/queueme/queueme.wxml-->
<view class="container">
    <!-- 棋盘 -->
    <text class="pink-blue small-text-ch" style="margin: 48px 12px 8px;">观众</text>
    <view class="base shadow" style="width: {{squareSize * col}}px; height: {{ squareSize * row}}px;">
        <view class="point pink-blue-bg small-text-ch {{activeIndex == item.index ? 'selected':''}}" wx:for="{{points}}" style="left: {{item.x}}px; top: {{item.y}}px; font-size: 12px; width: {{pointSize}}px; height: {{pointSize}}px;" catchtouchstart="touchStart" catchtouchmove="touchMove" catchtouchend="touchEnd" data-index="{{item.index}}" animation="{{animations[index]}}">{{item.index}}</view>

        <!-- Horizontal lines -->
        <block wx:for="{{row - 1}}" wx:key="index">
            <view class="line horizontal" style="top: {{squareSize * (index + 1)}}px;"></view>
        </block>
        <!-- Vertical lines -->
        <block wx:for="{{col - 1}}" wx:key="index">
            <view class="line vertical" style="left: {{squareSize * (index + 1)}}px;"></view>
        </block>
        <!-- Center mark -->
        <view class="horizontal" style="background-color: #fbc5ff; position: absolute; height: 2px; width: 10px; top: {{squareSize * row / 2 - 1}}px ; left:  {{squareSize * col / 2 - 5}}px; z-index: -1;"></view>
        <view class="vertical" style="background-color: #fbc5ff; position: absolute; height: 10px; width: 2px; top: {{squareSize * row / 2 - 5}}px ; left:  {{squareSize * col / 2 - 1}}px; z-index: -1;"></view>
        <!-- Back stage -->
        <view style="position: absolute; width: {{squareSize * 2}}px; height: {{squareSize * row}}px; background-color: rgba(211, 211, 211, 0.1); z-index: -1; border-radius: 20px 0px 0 20px;" ></view>
        <view style="position: absolute; right: 0; width: {{squareSize * 2}}px; height: {{squareSize * row}}px; background-color: rgba(211, 211, 211, 0.1); z-index: -1; border-radius: 0px 20px 20px 0px;" ></view>
        <view></view>
    </view>
    <text class="pink-blue small-text-ch" style="margin-top: 8px;">背面</text>
    <!-- 棋盘 -->

    <!-- 队列 -->
    <scroll-view class="queue-list" scroll-x enable-flex style="flex-direction: row;">
        <view class="queue shadow {{onSelect == index ? 'pink-blue-bg' : ''}}" bindtap="onSelect" data-index="{{index}}" wx:key="index" wx:for="{{savedQueue.length}}" wx:for-item="item" wx:for-index="index">
            <text class="small-text-ch" style="color: #ffffff;">Queue{{index}}</text>
        </view>
        <view class="queue-add shadow" bindtap="addQueue">
            <text class="small-text-ch" style="color: #ffffff;">添加Queue</text>
        </view>
    </scroll-view>

    <!-- 播放器 -->
    <view class="player">
        <slider class="slider" min="0" max="{{duration}}" value="{{currentTime}}" bindchange="seekAudio" activeColor="#fbc5ff" backgroundColor="rgba(211, 211, 211, 0.1)" block-size="20" block-color="#fbc5ff" bindchanging="onSliderChanging">
        </slider>
        <view class="time">
            <text class="small-text-ch pink-blue">{{formatCurrentTime}}</text>
            <text class="small-text-ch pink-blue">{{formatDuration}}</text>
        </view>
        <view class="btn">
            <button class="playBtn pink-blue-bg" bindtap="playAudio">
                <!-- <view class="round">
                    <text class="small-text-ch pink-blue" style="position: absolute; top: 12px; left: 55px;">▶</text>
                </view> -->
                <text style="color: #2b2b2b;">▶</text>

            </button>
            <!-- <button class="playBtn pink-blue-bg right-btn" bindtap="pauseAudio">
                <view class="round">
                    <text class="small-text-ch pink-blue" style="position: absolute;left: 48px;">⏸</text>
                </view>
        
            </button> -->

        </view>
    </view>
    <!-- 播放器 -->
</view>
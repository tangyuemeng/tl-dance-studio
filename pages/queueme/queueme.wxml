<!--pages/queueme/queueme.wxml-->
<view class="container">
    <!-- <view class="count-ball pink-blue-bg mt-lg {{count > 0 ? 'show' : 'hide'}}">
        <text class="middle-text-ch" style="color: #2B2B2B;">{{count}}</text>
    </view> -->

    <!-- 棋盘 -->
    <text class="pink-blue small-text-ch" style="margin-bottom: 12px;">观众</text>

    <view class="base">

        <view class="point pink-blue-bg small-text-ch {{activeIndex == item.index ? 'selected':''}}" wx:for="{{points}}" style="left: {{item.x}}px; top: {{item.y}}px; font-size: 12px;" catchtouchstart="touchStart" catchtouchmove="touchMove" catchtouchend="touchEnd" data-index="{{item.index}}" animation="{{animations[index]}}">{{item.index}}</view>

        <!-- Horizontal lines -->
        <block wx:for="{{6}}" wx:key="index">
            <view class="line horizontal" style="top: {{46.75 * index}}px;"></view>
        </block>
        <!-- Vertical lines -->
        <block wx:for="{{9}}" wx:key="index">
            <view class="line vertical" style="left: {{46.75 * index}}px;"></view>
        </block>
    </view>



    <text class="pink-blue small-text-ch" style="margin-top: 12px;">背面</text>
    <!-- 棋盘 -->

    <!-- 队列 -->
    <scroll-view class="queue-list" scroll-x enable-flex style="flex-direction: row;">
        <view class="queue {{onSelect == index ? 'pink-blue-bg' : ''}}" bindtap="onSelect" data-index="{{index}}" wx:key="index" wx:for="{{savedQueue.length}}" wx:for-item="item" wx:for-index="index">
            <text class="small-text-ch" style="color: #ffffff;">Queue{{index}}</text>
        </view>
        <view class="queue-add" bindtap="addQueue">
            <text class="small-text-ch" style="color: #ffffff;">添加Queue</text>
        </view>
    </scroll-view>

    <!-- 播放器 -->
    <view class="player">
        <slider class="slider" min="0" max="{{duration}}" value="{{currentTime}}" bindchange="seekAudio" activeColor="#fbc5ff" backgroundColor="rgba(211, 211, 211, 0.1)" block-size="20" block-color="#fbc5ff" bindchanging="onSliderChanging">
        </slider>
        <view class="time">
            <text class="small-text-ch pink-blue">{{formatCurrentTime}}</text>
            <text class="small-text-ch pink-blue">{{formatDuration}}</text>
        </view>
        <view class="btn">
            <button class="playBtn pink-blue-bg" bindtap="playAudio">
                <!-- <view class="round">
                    <text class="small-text-ch pink-blue" style="position: absolute; top: 12px; left: 55px;">▶</text>
                </view> -->
                <text style="color: #2b2b2b;">▶</text>
          
            </button>
            <!-- <button class="playBtn pink-blue-bg right-btn" bindtap="pauseAudio">
                <view class="round">
                    <text class="small-text-ch pink-blue" style="position: absolute;left: 48px;">⏸</text>
                </view>
        
            </button> -->

        </view>
    </view>
    <!-- 播放器 -->
</view>
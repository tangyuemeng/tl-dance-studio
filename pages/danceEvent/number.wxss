page {
    width: 100%;
    height: 100%;
    background-color: #f5f5f5;
}

.base-color {
    background: linear-gradient(
        95.55deg,
        #8e3b3c 45.57%,
        #d8cbc5 129.64%
    );
}
  
  .title-top {
    position: absolute;
    left: 5vw;
    top: 8vh;
    color: #d8cbc5;
  }

  .bar-list{
      position: absolute;
      top: 15vh;
      width: 100vw;
      height: 84vh;
  }

  .input-bar {
    border-bottom: 2px solid #8e3b3c;
    width: 90vw;
    height: 4vh;
    padding-left: 3vw;
  }
page {
  width: 100%;
  height: 100%;
  background-color: #2b2b2b;
}

.date-title {
  position: absolute;
  color: #f5f5f5;
  left: 8vw;
  top: 6vh;
}

.week-title {
  position: absolute;
  color: #f5f5f5;
  width: 15vw;
  height: 7vh;
  left: 4.6vw;
  top: 2vh;
}

.pink-card-top {
  position: absolute;
  width: 100vw;
  height: 33vh;

  /* PINKBLUE */

  background: linear-gradient(
    95.55deg,
    #fbc5ff 45.57%,
    rgba(187, 223, 241, 0.71) 129.64%
  );
  box-shadow: 0px 4px 4px rgba(0, 0, 0, 0.25);
  border-radius: 20px;
}

.scroll-view_H {
  position: absolute;
  white-space: nowrap;
  top: 19vh;
  padding-left: 4vw;
}

.blue-bar-top {
  position: relative;
  width: 25vw;
  height: 25vw;
  display: inline-block;
  margin-right: 6vw;
  background: #2b2b2b;
  box-shadow: 0px 4px 4px rgba(0, 0, 0, 0.25);
  border-radius: 20px;
}

.blue-bar-top:active {
  transform: translateY(1vw);
}

.back-icon {
  position: absolute;
  width: 9vw;
  height: 9vw;
  top: 11vh;
  left: 6vw;
}

.border-h {
  position: absolute;
  width: 100vw;
  height: 1px;
  top: 42vh;
  transform: rotate(0.27deg);
  border: 1px solid transparent;
  background: linear-gradient(
    95.55deg,
    #fbc5ff 45.57%,
    rgba(187, 223, 241, 0.71) 129.64%
  );
}

.border-v {
  position: absolute;
  width: 1px;
  height: 63vh;
  top: 36vh;
  left: 8vw;
  transform: rotate(0.27deg);
  border: 1px solid transparent;
  background: linear-gradient(
    95.55deg,
    #fbc5ff 45.57%,
    rgba(187, 223, 241, 0.71) 129.64%
  );
}

.class-list {
  position: absolute;
  top: 42vh;
  width: 86vw;
  height: 55vh;
  left: 10vw;
  padding-left: 4vw;
  padding-top: 2vh;
  padding-bottom: 1vh;
}

.class-item {
  position: relative;
  width: 80vw;
  height: 15vh;
  background: #2b2b2b;
  border: 3px solid #fbc5ff;
  box-shadow: 0px 4px 4px rgba(0, 0, 0, 0.25);
  border-radius: 20px;
  margin-bottom: 2vh;
}

.class-item.isTiktok {
  height: 20vh;
}

.class-item:active {
  box-shadow: 4px 12px 12px rgba(241, 128, 245, 0.25);
  transform: translateY(1vw);
}

.item-image {
  position: absolute;
  width: 28vw;
  height: 13vh;
  top: 1vh;
  left: 2vw;
  border-radius: 20px;
}

.item-title {
  position: absolute;
  top: 0.6vh;
  left: 33vw;
  color: #f5f5f5;
}

.item-num {
  position: absolute;
  top: 10vh;
  right: 3vw;
  color: #f5f5f5;
}

.item-time {
  position: absolute;
  top: 4.5vh;
  left: 33vw;
  color: #f5f5f5;
}

.item-teacher {
  position: absolute;
  top: 10vh;
  left: 33vw;
  color: #f5f5f5;
}

.item-tiktok {
  position: absolute;
  border: 2px solid rgba(187, 223, 241, 0.7);
  border-radius: 20px;
  top: 15vh;
  color: #f5f5f5;
  margin-left: 2.6vw;
  padding: 0 10vw 0 10vw;
}

.item-tiktok::after {
  content: "❤"; /* 爱心 */
  position: absolute;
  top: -16px; /* 调整爱心位置 */
  right: -8px;
  color: #fbc5ff; /* 爱心颜色 */
  font-size: 24px;
  padding: 5px;
}

.item-tiktok-content {
  position: absolute;
  color: #fbc5ff;
  margin-left: 2.6vw;
  top: 15.3vh;
  right: -0vw;
  padding: 0 10vw 0 10vw;
}

.loding {
  position: absolute;
  width: 30vw;
  height: 30vw;
  top: 50vh;
  left: 40vw;
}
